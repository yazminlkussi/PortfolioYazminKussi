---
// Moodboard: fotos que llegan en vivo desde Openverse (https://api.openverse.org), el buscador de
// imágenes con licencia Creative Commons de WordPress. No necesita clave. Pido solo fotos verticales,
// el formato de Pinterest. (Antes usaba la colección del V&A Museum, pero sus piezas eran grabados y
// objetos antiguos: no tenían la estética que buscaba para el tablero.)
// (Primero probé la del Art Institute of Chicago, pero bloquea pedidos desde el navegador.)
//
// Estados que resuelve:
//   cargando -> esqueletos de papel
//   listo    -> grilla de obras
//   vacio    -> la búsqueda no trajo obras con imagen
//   error    -> sin conexión, API caída, demora > 30 s o límite de pedidos (con botón "reintentar")
//
// Openverse tarda entre 15 y 25 s en responder una búsqueda nueva. Por eso los temas fijos vienen
// precargados (src/data/inspo.json) y se ven al instante. El buscador consulta la API en vivo.
//
// Cada obra se puede "pegar" en la Mesa de collage: se manda un evento
// `mesa:pegar` que escucha el componente MesaDeCollage.

interface Tema {
  etiqueta: string;
  busqueda: string;
}

interface Props {
  temas: Tema[];
}

const { temas } = Astro.props;

// ---------- Temas precargados ----------
// Openverse es lento e inestable con búsquedas nuevas, así que las fotos de los temas fijos se bajan con
// `node scripts/actualizar-inspo.mjs` y quedan guardadas en src/data/inspo.json. Llegan dentro del HTML.
import inspo from "../data/inspo.json";

const precarga: Record<string, unknown[]> = Object.fromEntries(
  temas.map((t) => [t.busqueda, (inspo as Record<string, unknown[]>)[t.busqueda] ?? []])
);

---

<div class="mood" data-mood>
  <script type="application/json" data-precarga set:html={JSON.stringify(precarga)} />
  <div class="mood__controles">
    <div class="mood__temas" role="group" aria-label="Temas del moodboard">
      {
        temas.map((t, i) => (
          <button
            class="chip"
            type="button"
            data-busqueda={t.busqueda}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {t.etiqueta}
          </button>
        ))
      }
    </div>

    <form class="mood__buscar" data-buscar role="search">
      <label class="sr-only" for="mood-q">Buscar obras (en inglés)</label>
      <button class="mood__lupa" type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
          <path d="M15.5 15.5 20 20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
      <input id="mood-q" name="q" type="search" placeholder="buscá: matisse, poster, flowers…" autocomplete="off" />
    </form>
  </div>

  <!-- aria-live: avisa a lectores de pantalla cuando cambia el estado -->
  <p class="mood__estado" data-estado aria-live="polite"></p>

  <div class="mood__tablero" data-tablero>
    <ul class="mood__grilla" data-grilla aria-busy="true"></ul>
  </div>

  <div class="mood__aviso" data-aviso hidden>
    <p class="mood__aviso-titulo" data-aviso-titulo></p>
    <p class="mood__aviso-texto" data-aviso-texto></p>
    <button class="boton" type="button" data-reintentar>Reintentar</button>
  </div>

  <p class="mood__credito">
    Fotos con licencia Creative Commons vía{" "}
    <a href="https://openverse.org" target="_blank" rel="noopener">Openverse</a>. Cada pin conserva el crédito de su
    autor y su licencia.
  </p>
</div>

<style>
  /* ---------- Controles: tags + buscador en píldora ---------- */
  .mood__controles {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
    justify-content: space-between;
    margin: 22px 0 10px;
  }

  .mood__temas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    font: 500 0.9375rem/1 var(--f-texto);
    color: var(--tinta);
    background: color-mix(in srgb, var(--tinta) 6%, transparent);
    border: 0;
    border-radius: 999px;
    padding: 10px 16px;
    min-height: 40px;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease;
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip[aria-pressed="true"] {
    background: var(--tinta);
    color: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip:not([aria-pressed="true"]):hover {
      background: color-mix(in srgb, var(--tinta) 11%, transparent);
    }
  }

  .mood__buscar {
    position: relative;
    display: flex;
    flex: 1 1 260px;
    max-width: 380px;
  }

  .mood__buscar input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    /* 16px evita que el celular haga zoom al tocar el campo */
    font: 400 1rem var(--f-texto);
    color: var(--tinta);
    background: color-mix(in srgb, var(--tinta) 6%, transparent);
    border: 2px solid transparent;
    border-radius: 999px;
    padding: 0 18px 0 46px;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .mood__buscar input:focus {
    outline: none;
    background: #fff;
    border-color: color-mix(in srgb, var(--azul) 55%, transparent);
  }

  .mood__buscar input::placeholder {
    color: var(--gris);
  }

  .mood__lupa {
    position: absolute;
    left: 4px;
    top: 50%;
    translate: 0 -50%;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--tinta-suave);
    cursor: pointer;
  }

  .mood__estado {
    min-height: 1.5em;
    font-size: 0.875rem;
    color: var(--tinta-suave);
    margin: 0 0 12px;
  }

  /* ---------- Tablero masonry ---------- */
  .mood__grilla {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 2;
    column-gap: 12px;
  }

  @media (min-width: 640px) {
    .mood__grilla {
      columns: 4 170px;
      column-gap: 14px;
    }
  }

  @media (min-width: 1300px) {
    .mood__grilla {
      columns: 5 170px;
    }
  }

  /* Cada foto es un sticker: borde blanco troquelado, apenas torcido, con sombra de papel.
     La sombra va en el <li> (filter) porque el marco se recorta con clip-path en la esquina despegada. */
  .mood__grilla :global(.obra) {
    position: relative;
    break-inside: avoid;
    margin: 0 0 18px;
    padding: 4px;
    filter: drop-shadow(0 1px 1px rgb(60 40 40 / 0.14)) drop-shadow(0 6px 10px rgb(60 40 40 / 0.12));
    animation: aparecer 460ms var(--ease-out) both;
    animation-delay: calc(min(var(--i, 0), 12) * 40ms);
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
  }

  .mood__grilla :global(.obra__marco) {
    --borde: 7px;
    --radio: 14px;
    position: relative;
    padding: var(--borde);
    background: #fffdfb;
    border-radius: calc(var(--radio) + var(--borde));
    transform: rotate(var(--giro, 0deg));
    transition: transform 260ms var(--ease-out);
  }

  /* Formas: algunos stickers son arco, otros tienen una esquina despegada */
  .mood__grilla :global(.obra[data-forma="arco"] .obra__marco) {
    --radio: 999px 999px 14px 14px;
    border-radius: 999px 999px 21px 21px;
  }

  .mood__grilla :global(.obra[data-forma="despegado"] .obra__marco) {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 26px), calc(100% - 26px) 100%, 0 100%);
  }

  /* la solapa doblada: muestra el dorso del sticker */
  .mood__grilla :global(.obra[data-forma="despegado"] .obra__marco::after) {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26px;
    height: 26px;
    background: linear-gradient(to bottom right, #fbf7f2 0%, #e4ddd3 50%, transparent 50%);
    border-radius: 0 0 4px 0;
    filter: drop-shadow(-1px -1px 1.5px rgb(0 0 0 / 0.16));
  }

  /* brillo de vinilo */
  .mood__grilla :global(.obra__marco::before) {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(125deg, rgb(255 255 255 / 0.32) 0%, rgb(255 255 255 / 0) 34%);
    pointer-events: none;
    z-index: 2;
  }

  .mood__grilla :global(.obra img) {
    display: block;
    width: 100%;
    height: auto;
    min-height: 140px;
    border-radius: var(--radio);
    /* color de espera mientras baja la imagen, distinto por sticker */
    background: var(--espera, var(--papel-2));
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .mood__grilla :global(.obra img[data-lista]) {
    min-height: 0;
    opacity: 1;
  }

  /* Velo y datos que aparecen sobre la imagen */
  .mood__grilla :global(.obra__velo) {
    position: absolute;
    inset: var(--borde);
    border-radius: var(--radio);
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 10px;
    background: linear-gradient(rgb(0 0 0 / 0.28), transparent 38%, transparent 55%, rgb(0 0 0 / 0.5));
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .mood__grilla :global(.obra__autor) {
    align-self: flex-start;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mood__grilla :global(.obra__pegar) {
    font: 500 0.875rem/1 var(--f-texto);
    color: var(--tinta);
    background: var(--rosa-fuerte);
    border: 0;
    border-radius: 999px;
    padding: 0 16px;
    min-height: 40px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
    transition: transform 160ms var(--ease-out), background-color 160ms ease;
  }

  .mood__grilla :global(.obra__pegar:active) {
    transform: scale(0.96);
  }

  .mood__grilla :global(.obra__pegar[data-pegado]) {
    background: var(--tinta);
    color: #fff;
  }

  /* Los stickers no llevan epígrafe: el título queda solo para lectores de pantalla */
  .mood__grilla :global(.obra__titulo) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Con mouse: el velo aparece al pasar por encima (o al navegar con teclado) */
  @media (hover: hover) and (pointer: fine) {
    .mood__grilla :global(.obra:hover .obra__velo),
    .mood__grilla :global(.obra:focus-within .obra__velo) {
      opacity: 1;
    }

    /* al pasar el mouse el sticker se endereza y se levanta un poco */
    .mood__grilla :global(.obra:hover .obra__marco) {
      transform: rotate(0deg) translateY(-3px) scale(1.02);
    }
  }

  /* Pantallas táctiles: el botón siempre visible, sin velo oscuro */
  @media not ((hover: hover) and (pointer: fine)) {
    .mood__grilla :global(.obra__velo) {
      opacity: 1;
      background: none;
      justify-content: flex-end;
    }

    .mood__grilla :global(.obra__autor) {
      display: none;
    }

    .mood__grilla :global(.obra__pegar) {
      min-height: 36px;
      padding: 0 12px;
      font-size: 0.8125rem;
    }
  }

  /* Pegada: se queda a la vista aunque no haya hover */
  .mood__grilla :global(.obra:has([data-pegado]) .obra__velo) {
    opacity: 1;
  }

  /* Esqueleto mientras carga */
  .mood__grilla :global(.obra--esqueleto) {
    height: var(--alto, 260px);
    border-radius: 21px;
    border: 7px solid #fffdfb;
    background: var(--espera, var(--papel-2));
    transform: rotate(var(--giro, 0deg));
    animation: respirar 1.1s ease-in-out infinite alternate;
  }

  @keyframes respirar {
    to {
      opacity: 0.45;
    }
  }

  /* Error o vacío: un cuadro de diálogo de sistema */
  .mood__aviso {
    max-width: 380px;
    margin: 24px auto;
    text-align: center;
    padding: 24px 20px;
    background: #f4f4f4;
    border: 1px solid var(--chrome-borde);
    border-radius: 16px;
    box-shadow: var(--sombra-foto);
  }

  .mood__aviso-titulo {
    font-weight: 500;
    font-size: 1.125rem;
    margin: 0 0 6px;
  }

  .mood__aviso-texto {
    color: var(--tinta-suave);
    font-size: 0.9375rem;
    margin: 0 auto 18px;
  }

  .mood__credito {
    font-size: 0.75rem;
    color: var(--tinta-suave);
    margin: 10px 0 0;
  }

  /* Escritorio: el tablero scrollea por dentro, así la hoja entra en pantalla */
  @media (min-width: 1100px) and (min-height: 640px) {
    .mood {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .mood__tablero {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      margin-inline: -6px;
      padding: 0 6px 24px;
      scrollbar-width: thin;
      scrollbar-color: var(--chrome-borde) transparent;
      /* las fotos se desvanecen al llegar al borde de abajo */
      mask-image: linear-gradient(#000 calc(100% - 40px), transparent);
    }
  }
</style>

<script>
  const API = "https://api.openverse.org/v1/images/";
  // Openverse es lento con búsquedas nuevas (medí 16 a 26 s): le damos margen y avisamos si tarda
  const LIMITE_MS = 30000;
  const AVISO_LENTO_MS = 5000;

  // Lo que devuelve la API (solo los campos que usamos)
  interface RegistroOpenverse {
    id: string;
    title?: string;
    creator?: string | null;
    license?: string;
    url?: string;
    thumbnail?: string;
  }

  // Nuestra versión "limpia" de una foto
  interface Obra {
    id: string;
    titulo: string;
    autor: string;
    fecha: string; // acá va la licencia (ej. "CC BY")
    imagen: string; // miniatura liviana para el tablero
    original: string; // por si la miniatura falla
  }

  // Las fotos de Flickr vienen en tamaños grandes: pedimos la versión de 640 px (sufijo _z), que alcanza
  // para el tablero y pesa mucho menos
  const achicar = (u?: string) =>
    u?.replace(/^(https:\/\/live\.staticflickr\.com\/\d+\/\d+_[0-9a-f]+)(_[a-z0-9])?\.(jpg|png)$/, "$1_z.jpg");

  // Pasamos del formato de la API a nuestro formato
  function aObra(r: RegistroOpenverse): Obra | null {
    const imagen = achicar(r.url) || r.thumbnail; // la original carga más rápido que la miniatura de Openverse
    if (!imagen) return null; // sin imagen no nos sirve
    return {
      id: r.id,
      titulo: (r.title || "Sin título").trim(),
      autor: r.creator ? `foto: ${r.creator}` : "Autor desconocido",
      fecha: r.license ? `CC ${r.license.toUpperCase()}` : "",
      imagen,
      original: r.thumbnail ?? imagen,
    };
  }

  const raiz = document.querySelector<HTMLElement>("[data-mood]")!;
  const grilla = raiz.querySelector<HTMLUListElement>("[data-grilla]")!;
  const estado = raiz.querySelector<HTMLElement>("[data-estado]")!;
  const aviso = raiz.querySelector<HTMLElement>("[data-aviso]")!;
  const avisoTitulo = raiz.querySelector<HTMLElement>("[data-aviso-titulo]")!;
  const avisoTexto = raiz.querySelector<HTMLElement>("[data-aviso-texto]")!;
  const chips = [...raiz.querySelectorAll<HTMLButtonElement>(".chip")];
  const form = raiz.querySelector<HTMLFormElement>("[data-buscar]")!;

  let busquedaActual = chips[0]?.dataset.busqueda ?? "collage";

  // Temas que ya vinieron dentro del HTML (pedidos en el build)
  let precarga: Record<string, Obra[]> = {};
  try {
    precarga = JSON.parse(raiz.querySelector("[data-precarga]")?.textContent || "{}");
  } catch {
    precarga = {};
  }
  let pedido: AbortController | null = null;

  // Colores suaves de espera (como Pinterest: cada pin tiene su color mientras carga)
  const ESPERAS = ["#f3dfe5", "#e8e4dc", "#dfe6ee", "#efe7d6", "#e6e0ec", "#f1e3da"];
  // Cada sticker queda pegado un poco torcido, y algunos cambian de forma
  const GIROS = [-2.2, 1.6, -0.8, 2.4, -1.6, 0.6, 1.9, -2.6, 1.1];
  const forma = (i: number) => (i % 7 === 2 ? "arco" : i % 5 === 3 ? "despegado" : "");

  // ---------- Estados ----------
  function mostrarCargando() {
    aviso.hidden = true;
    grilla.setAttribute("aria-busy", "true");
    estado.textContent = `Buscando “${busquedaActual}”…`;
    const altos = [280, 200, 320, 240, 300, 220, 260, 340, 210, 290];
    grilla.innerHTML = altos
      .map(
        (a, i) =>
          `<li class="obra obra--esqueleto" style="--alto:${a}px;--espera:${ESPERAS[i % ESPERAS.length]};--giro:${GIROS[i % GIROS.length]}deg" aria-hidden="true"></li>`
      )
      .join("");
  }

  function mostrarAviso(titulo: string, texto: string, conReintento: boolean) {
    grilla.innerHTML = "";
    grilla.setAttribute("aria-busy", "false");
    avisoTitulo.textContent = titulo;
    avisoTexto.textContent = texto;
    aviso.querySelector<HTMLElement>("[data-reintentar]")!.hidden = !conReintento;
    aviso.hidden = false;
  }

  function mostrarObras(obras: Obra[]) {
    aviso.hidden = true;
    grilla.setAttribute("aria-busy", "false");
    estado.textContent = `${obras.length} fotos de “${busquedaActual}”. Pegá las que te gusten en la mesa.`;
    grilla.innerHTML = "";

    obras.forEach((obra, i) => {
      const li = document.createElement("li");
      li.className = "obra";
      li.style.setProperty("--i", String(i));
      li.style.setProperty("--espera", ESPERAS[i % ESPERAS.length]);
      li.style.setProperty("--giro", `${GIROS[i % GIROS.length]}deg`);
      if (forma(i)) li.dataset.forma = forma(i);

      const marco = document.createElement("div");
      marco.className = "obra__marco";

      const img = document.createElement("img");
      img.src = obra.imagen;
      img.alt = `${obra.titulo}, ${obra.autor}`;
      img.loading = "lazy";
      img.decoding = "async";
      // Aparece con un fundido cuando terminó de bajar
      img.addEventListener("load", () => (img.dataset.lista = ""));
      // Si la miniatura falla probamos con la original; si tampoco carga, sacamos ese pin
      img.addEventListener("error", () => {
        if (img.src !== obra.original) img.src = obra.original;
        else li.remove();
      });

      const velo = document.createElement("div");
      velo.className = "obra__velo";

      const titulo = document.createElement("p");
      titulo.className = "obra__titulo";
      titulo.textContent = obra.titulo;

      const autor = document.createElement("p");
      autor.className = "obra__autor";
      autor.textContent = [obra.autor, obra.fecha].filter(Boolean).join(" · ");

      const pegar = document.createElement("button");
      pegar.type = "button";
      pegar.className = "obra__pegar";
      pegar.textContent = "Pegar";
      pegar.setAttribute("aria-label", `Pegar “${obra.titulo}” en la mesa`);
      pegar.addEventListener("click", () => {
        // Segundo clic: ya está pegada, te lleva a la hoja de la mesa
        if ("pegado" in pegar.dataset) {
          location.hash = "mesa";
          return;
        }
        window.dispatchEvent(
          new CustomEvent("mesa:pegar", {
            detail: { id: `obra-${obra.id}`, src: obra.imagen, titulo: obra.titulo },
          })
        );
        pegar.dataset.pegado = "";
        pegar.textContent = "✓ Pegada · ver →";
        pegar.setAttribute("aria-label", `“${obra.titulo}” ya está pegada. Ir a la mesa`);
      });

      velo.append(pegar, autor);
      marco.append(img, velo);
      li.append(marco, titulo);
      grilla.append(li);
    });
  }

  // ---------- Pedido a la API ----------
  async function cargar(busqueda: string) {
    busquedaActual = busqueda;

    // Cache por sesión: si ya buscaste esto, no volvemos a pedirlo
    if (precarga[busqueda]?.length) return mostrarResultado(precarga[busqueda]);

    const claveCache = `mood-ov:${busqueda}`;
    try {
      const guardado = sessionStorage.getItem(claveCache);
      if (guardado) return mostrarResultado(JSON.parse(guardado));
    } catch {
      /* sessionStorage puede no estar disponible: seguimos sin cache */
    }

    // Si había un pedido anterior en curso, lo cancelamos
    pedido?.abort();
    const ctrl = new AbortController();
    pedido = ctrl;
    const temporizador = setTimeout(() => ctrl.abort("timeout"), LIMITE_MS);
    const lento = setTimeout(() => {
      if (pedido === ctrl) estado.textContent = `Openverse está lento con “${busqueda}”, sigue buscando…`;
    }, AVISO_LENTO_MS);

    mostrarCargando();

    const params = new URLSearchParams({
      q: busqueda,
      aspect_ratio: "tall", // solo fotos verticales, como en Pinterest
      page_size: "20", // sin clave, Openverse acepta hasta 20 por pedido (más devuelve 401)
    });

    try {
      const res = await fetch(`${API}?${params}`, { signal: ctrl.signal });
      // 429: Openverse limita las búsquedas anónimas (20 por minuto y 200 por día)
      if (res.status === 429) throw new Error("limite");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      // Nos quedamos solo con las fotos que tienen imagen
      const obras = ((json.results ?? []) as RegistroOpenverse[])
        .map(aObra)
        .filter((o): o is Obra => o !== null)
        .slice(0, 24);
      try {
        sessionStorage.setItem(claveCache, JSON.stringify(obras));
      } catch {
        /* sin cache, no pasa nada */
      }
      mostrarResultado(obras);
    } catch (err) {
      // Un pedido cancelado porque elegiste otro tema no es un error
      if (ctrl.signal.aborted && ctrl.signal.reason !== "timeout") return;
      const porTiempo = ctrl.signal.reason === "timeout";
      estado.textContent = "";
      const porLimite = err instanceof Error && err.message === "limite";
      mostrarAviso(
        "Se trabó la imprenta",
        porLimite
          ? "Hiciste muchas búsquedas seguidas y Openverse pide una pausa. Probá de nuevo en un minuto."
          : porTiempo
            ? "Las fotos están tardando demasiado en llegar. Probá de nuevo en un ratito."
            : "No pude traer las fotos. Revisá tu conexión o probá de nuevo.",
        true
      );
      console.warn("[moodboard]", err);
    } finally {
      clearTimeout(temporizador);
      clearTimeout(lento);
    }
  }

  function mostrarResultado(obras: Obra[]) {
    if (obras.length === 0) {
      estado.textContent = "";
      mostrarAviso(
        "Página en blanco",
        `No encontré fotos para “${busquedaActual}”. Probá con otra palabra (en inglés funciona mejor).`,
        false
      );
    } else {
      mostrarObras(obras);
    }
  }

  // ---------- Interacciones ----------
  function elegirChip(chip: HTMLButtonElement | null) {
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      elegirChip(chip);
      cargar(chip.dataset.busqueda!);
    })
  );

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = String(new FormData(form).get("q") ?? "").trim();
    if (!q) return;
    elegirChip(null);
    cargar(q);
  });

  aviso.querySelector("[data-reintentar]")!.addEventListener("click", () => {
    try {
      sessionStorage.removeItem(`mood-ov:${busquedaActual}`);
    } catch {}
    cargar(busquedaActual);
  });

  // Recién pedimos a la API cuando el moodboard está por aparecer en pantalla
  const alVer = new IntersectionObserver(
    (entradas) => {
      if (entradas.some((e) => e.isIntersecting)) {
        alVer.disconnect();
        cargar(busquedaActual);
      }
    },
    { rootMargin: "400px 0px" }
  );
  alVer.observe(raiz);
</script>
