---
// Moodboard: obras que llegan en vivo desde la API pública de colecciones del
// Victoria and Albert Museum de Londres (https://developers.vam.ac.uk/). No necesita clave.
// (Primero probé la del Art Institute of Chicago, pero bloquea pedidos desde el navegador.)
//
// Estados que resuelve:
//   cargando -> esqueletos de papel
//   listo    -> grilla de obras
//   vacio    -> la búsqueda no trajo obras con imagen
//   error    -> sin conexión, API caída o demora > 8 s (con botón "reintentar")
//
// Cada obra se puede "pegar" en la Mesa de collage: se manda un evento
// `mesa:pegar` que escucha el componente MesaDeCollage.

interface Tema {
  etiqueta: string;
  busqueda: string;
}

interface Props {
  temas: Tema[];
}

const { temas } = Astro.props;
---

<div class="mood" data-mood>
  <div class="mood__controles">
    <div class="mood__temas" role="group" aria-label="Temas del moodboard">
      {
        temas.map((t, i) => (
          <button
            class="chip"
            type="button"
            data-busqueda={t.busqueda}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {t.etiqueta}
          </button>
        ))
      }
    </div>

    <form class="mood__buscar" data-buscar role="search">
      <label class="sr-only" for="mood-q">Buscar obras (en inglés)</label>
      <button class="mood__lupa" type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
          <path d="M15.5 15.5 20 20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
      <input id="mood-q" name="q" type="search" placeholder="buscá: matisse, poster, flowers…" autocomplete="off" />
    </form>
  </div>

  <!-- aria-live: avisa a lectores de pantalla cuando cambia el estado -->
  <p class="mood__estado" data-estado aria-live="polite"></p>

  <div class="mood__tablero" data-tablero>
    <ul class="mood__grilla" data-grilla aria-busy="true"></ul>
  </div>

  <div class="mood__aviso" data-aviso hidden>
    <p class="mood__aviso-titulo" data-aviso-titulo></p>
    <p class="mood__aviso-texto" data-aviso-texto></p>
    <button class="boton" type="button" data-reintentar>Reintentar</button>
  </div>

  <p class="mood__credito">
    Imágenes de la colección del Victoria and Albert Museum, Londres, vía su
    <a href="https://developers.vam.ac.uk/" target="_blank" rel="noopener">API pública</a>. Uso no comercial.
  </p>
</div>

<style>
  /* ---------- Controles: tags + buscador en píldora ---------- */
  .mood__controles {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
    justify-content: space-between;
    margin: 22px 0 10px;
  }

  .mood__temas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    font: 500 0.9375rem/1 var(--f-texto);
    color: var(--tinta);
    background: color-mix(in srgb, var(--tinta) 6%, transparent);
    border: 0;
    border-radius: 999px;
    padding: 10px 16px;
    min-height: 40px;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease;
  }

  .chip:active {
    transform: scale(0.97);
  }

  .chip[aria-pressed="true"] {
    background: var(--tinta);
    color: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip:not([aria-pressed="true"]):hover {
      background: color-mix(in srgb, var(--tinta) 11%, transparent);
    }
  }

  .mood__buscar {
    position: relative;
    display: flex;
    flex: 1 1 260px;
    max-width: 380px;
  }

  .mood__buscar input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    /* 16px evita que el celular haga zoom al tocar el campo */
    font: 400 1rem var(--f-texto);
    color: var(--tinta);
    background: color-mix(in srgb, var(--tinta) 6%, transparent);
    border: 2px solid transparent;
    border-radius: 999px;
    padding: 0 18px 0 46px;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .mood__buscar input:focus {
    outline: none;
    background: #fff;
    border-color: color-mix(in srgb, var(--azul) 55%, transparent);
  }

  .mood__buscar input::placeholder {
    color: var(--gris);
  }

  .mood__lupa {
    position: absolute;
    left: 4px;
    top: 50%;
    translate: 0 -50%;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--tinta-suave);
    cursor: pointer;
  }

  .mood__estado {
    min-height: 1.5em;
    font-size: 0.875rem;
    color: var(--tinta-suave);
    margin: 0 0 12px;
  }

  /* ---------- Tablero masonry ---------- */
  .mood__grilla {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 2;
    column-gap: 12px;
  }

  @media (min-width: 640px) {
    .mood__grilla {
      columns: 4 170px;
      column-gap: 14px;
    }
  }

  @media (min-width: 1300px) {
    .mood__grilla {
      columns: 5 170px;
    }
  }

  /* Cada pin: la imagen manda, redondeada y sin marco */
  .mood__grilla :global(.obra) {
    position: relative;
    break-inside: avoid;
    margin: 0 0 16px;
    animation: aparecer 420ms var(--ease-out) both;
    animation-delay: calc(min(var(--i, 0), 12) * 40ms);
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .mood__grilla :global(.obra__marco) {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    /* color de espera mientras baja la imagen, distinto por pin */
    background: var(--espera, var(--papel-2));
    transition: transform 200ms var(--ease-out);
  }

  .mood__grilla :global(.obra img) {
    display: block;
    width: 100%;
    height: auto;
    min-height: 140px;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .mood__grilla :global(.obra img[data-lista]) {
    min-height: 0;
    opacity: 1;
  }

  /* Velo y datos que aparecen sobre la imagen */
  .mood__grilla :global(.obra__velo) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 10px;
    background: linear-gradient(rgb(0 0 0 / 0.28), transparent 38%, transparent 55%, rgb(0 0 0 / 0.5));
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .mood__grilla :global(.obra__autor) {
    align-self: flex-start;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mood__grilla :global(.obra__pegar) {
    font: 500 0.875rem/1 var(--f-texto);
    color: var(--tinta);
    background: var(--rosa-fuerte);
    border: 0;
    border-radius: 999px;
    padding: 0 16px;
    min-height: 40px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
    transition: transform 160ms var(--ease-out), background-color 160ms ease;
  }

  .mood__grilla :global(.obra__pegar:active) {
    transform: scale(0.96);
  }

  .mood__grilla :global(.obra__pegar[data-pegado]) {
    background: var(--tinta);
    color: #fff;
  }

  .mood__grilla :global(.obra__titulo) {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 6px 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Con mouse: el velo aparece al pasar por encima (o al navegar con teclado) */
  @media (hover: hover) and (pointer: fine) {
    .mood__grilla :global(.obra:hover .obra__velo),
    .mood__grilla :global(.obra:focus-within .obra__velo) {
      opacity: 1;
    }

    .mood__grilla :global(.obra:hover .obra__marco) {
      transform: scale(0.985);
    }
  }

  /* Pantallas táctiles: el botón siempre visible, sin velo oscuro */
  @media not ((hover: hover) and (pointer: fine)) {
    .mood__grilla :global(.obra__velo) {
      opacity: 1;
      background: none;
      justify-content: flex-end;
    }

    .mood__grilla :global(.obra__autor) {
      display: none;
    }

    .mood__grilla :global(.obra__pegar) {
      min-height: 36px;
      padding: 0 12px;
      font-size: 0.8125rem;
    }
  }

  /* Pegada: se queda a la vista aunque no haya hover */
  .mood__grilla :global(.obra:has([data-pegado]) .obra__velo) {
    opacity: 1;
  }

  /* Esqueleto mientras carga */
  .mood__grilla :global(.obra--esqueleto) {
    height: var(--alto, 260px);
    border-radius: 16px;
    background: var(--espera, var(--papel-2));
    animation: respirar 1.1s ease-in-out infinite alternate;
  }

  @keyframes respirar {
    to {
      opacity: 0.45;
    }
  }

  /* Error o vacío: un cuadro de diálogo de sistema */
  .mood__aviso {
    max-width: 380px;
    margin: 24px auto;
    text-align: center;
    padding: 24px 20px;
    background: #f4f4f4;
    border: 1px solid var(--chrome-borde);
    border-radius: 16px;
    box-shadow: var(--sombra-foto);
  }

  .mood__aviso-titulo {
    font-weight: 500;
    font-size: 1.125rem;
    margin: 0 0 6px;
  }

  .mood__aviso-texto {
    color: var(--tinta-suave);
    font-size: 0.9375rem;
    margin: 0 auto 18px;
  }

  .mood__credito {
    font-size: 0.75rem;
    color: var(--tinta-suave);
    margin: 10px 0 0;
  }

  /* Escritorio: el tablero scrollea por dentro, así la hoja entra en pantalla */
  @media (min-width: 1100px) and (min-height: 640px) {
    .mood {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .mood__tablero {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      margin-inline: -6px;
      padding: 0 6px 24px;
      scrollbar-width: thin;
      scrollbar-color: var(--chrome-borde) transparent;
      /* las fotos se desvanecen al llegar al borde de abajo */
      mask-image: linear-gradient(#000 calc(100% - 40px), transparent);
    }
  }
</style>

<script>
  const API = "https://api.vam.ac.uk/v2/objects/search";
  const LIMITE_MS = 8000;

  // Lo que devuelve la API (solo los campos que usamos)
  interface RegistroVAM {
    systemNumber: string;
    objectType: string;
    _primaryTitle: string;
    _primaryMaker?: { name?: string };
    _primaryDate?: string;
    _images?: { _iiif_image_base_url?: string | null };
  }

  // Nuestra versión "limpia" de una obra
  interface Obra {
    id: string;
    titulo: string;
    autor: string;
    fecha: string;
    imagenBase: string;
  }

  // Pasamos del formato de la API a nuestro formato
  function aObra(r: RegistroVAM): Obra | null {
    const base = r._images?._iiif_image_base_url;
    if (!base) return null; // sin imagen no nos sirve
    const autor = r._primaryMaker?.name;
    return {
      id: r.systemNumber,
      titulo: r._primaryTitle || r.objectType || "Sin título",
      autor: autor && autor !== "Unknown" ? autor : "Autor desconocido",
      fecha: r._primaryDate ?? "",
      imagenBase: base,
    };
  }

  const raiz = document.querySelector<HTMLElement>("[data-mood]")!;
  const grilla = raiz.querySelector<HTMLUListElement>("[data-grilla]")!;
  const estado = raiz.querySelector<HTMLElement>("[data-estado]")!;
  const aviso = raiz.querySelector<HTMLElement>("[data-aviso]")!;
  const avisoTitulo = raiz.querySelector<HTMLElement>("[data-aviso-titulo]")!;
  const avisoTexto = raiz.querySelector<HTMLElement>("[data-aviso-texto]")!;
  const chips = [...raiz.querySelectorAll<HTMLButtonElement>(".chip")];
  const form = raiz.querySelector<HTMLFormElement>("[data-buscar]")!;

  let busquedaActual = chips[0]?.dataset.busqueda ?? "collage";
  let pedido: AbortController | null = null;

  // IIIF: pedimos la imagen al ancho justo que necesitamos
  const urlImagen = (base: string, ancho = 400) => `${base}full/${ancho},/0/default.jpg`;

  // Colores suaves de espera (como Pinterest: cada pin tiene su color mientras carga)
  const ESPERAS = ["#f3dfe5", "#e8e4dc", "#dfe6ee", "#efe7d6", "#e6e0ec", "#f1e3da"];

  // ---------- Estados ----------
  function mostrarCargando() {
    aviso.hidden = true;
    grilla.setAttribute("aria-busy", "true");
    estado.textContent = `Buscando obras de “${busquedaActual}”…`;
    const altos = [280, 200, 320, 240, 300, 220, 260, 340, 210, 290];
    grilla.innerHTML = altos
      .map(
        (a, i) =>
          `<li class="obra obra--esqueleto" style="--alto:${a}px;--espera:${ESPERAS[i % ESPERAS.length]}" aria-hidden="true"></li>`
      )
      .join("");
  }

  function mostrarAviso(titulo: string, texto: string, conReintento: boolean) {
    grilla.innerHTML = "";
    grilla.setAttribute("aria-busy", "false");
    avisoTitulo.textContent = titulo;
    avisoTexto.textContent = texto;
    aviso.querySelector<HTMLElement>("[data-reintentar]")!.hidden = !conReintento;
    aviso.hidden = false;
  }

  function mostrarObras(obras: Obra[]) {
    aviso.hidden = true;
    grilla.setAttribute("aria-busy", "false");
    estado.textContent = `${obras.length} obras de “${busquedaActual}”. Pegá las que te gusten en la mesa.`;
    grilla.innerHTML = "";

    obras.forEach((obra, i) => {
      const li = document.createElement("li");
      li.className = "obra";
      li.style.setProperty("--i", String(i));
      li.style.setProperty("--espera", ESPERAS[i % ESPERAS.length]);

      const marco = document.createElement("div");
      marco.className = "obra__marco";

      const img = document.createElement("img");
      img.src = urlImagen(obra.imagenBase);
      img.alt = `${obra.titulo}, ${obra.autor}`;
      img.loading = "lazy";
      img.decoding = "async";
      // Aparece con un fundido cuando terminó de bajar
      img.addEventListener("load", () => (img.dataset.lista = ""));
      // Si una imagen puntual no carga, sacamos esa obra sin romper el resto
      img.addEventListener("error", () => li.remove());

      const velo = document.createElement("div");
      velo.className = "obra__velo";

      const titulo = document.createElement("p");
      titulo.className = "obra__titulo";
      titulo.textContent = obra.titulo;

      const autor = document.createElement("p");
      autor.className = "obra__autor";
      autor.textContent = [obra.autor, obra.fecha].filter(Boolean).join(" · ");

      const pegar = document.createElement("button");
      pegar.type = "button";
      pegar.className = "obra__pegar";
      pegar.textContent = "Pegar";
      pegar.setAttribute("aria-label", `Pegar “${obra.titulo}” en la mesa`);
      pegar.addEventListener("click", () => {
        // Segundo clic: ya está pegada, te lleva a la hoja de la mesa
        if ("pegado" in pegar.dataset) {
          location.hash = "mesa";
          return;
        }
        window.dispatchEvent(
          new CustomEvent("mesa:pegar", {
            detail: { id: `obra-${obra.id}`, src: urlImagen(obra.imagenBase, 300), titulo: obra.titulo },
          })
        );
        pegar.dataset.pegado = "";
        pegar.textContent = "✓ Pegada · ver →";
        pegar.setAttribute("aria-label", `“${obra.titulo}” ya está pegada. Ir a la mesa`);
      });

      velo.append(pegar, autor);
      marco.append(img, velo);
      li.append(marco, titulo);
      grilla.append(li);
    });
  }

  // ---------- Pedido a la API ----------
  async function cargar(busqueda: string) {
    busquedaActual = busqueda;

    // Cache por sesión: si ya buscaste esto, no volvemos a pedirlo
    const claveCache = `mood-vam2:${busqueda}`;
    try {
      const guardado = sessionStorage.getItem(claveCache);
      if (guardado) return mostrarResultado(JSON.parse(guardado));
    } catch {
      /* sessionStorage puede no estar disponible: seguimos sin cache */
    }

    // Si había un pedido anterior en curso, lo cancelamos
    pedido?.abort();
    const ctrl = new AbortController();
    pedido = ctrl;
    const temporizador = setTimeout(() => ctrl.abort("timeout"), LIMITE_MS);

    mostrarCargando();

    const params = new URLSearchParams({
      q: busqueda,
      images_exist: "1", // solo objetos con foto
      page_size: "30",
    });

    try {
      const res = await fetch(`${API}?${params}`, { signal: ctrl.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      // Nos quedamos solo con las obras que tienen imagen
      const obras = ((json.records ?? []) as RegistroVAM[])
        .map(aObra)
        .filter((o): o is Obra => o !== null)
        .slice(0, 24);
      try {
        sessionStorage.setItem(claveCache, JSON.stringify(obras));
      } catch {
        /* sin cache, no pasa nada */
      }
      mostrarResultado(obras);
    } catch (err) {
      // Un pedido cancelado porque elegiste otro tema no es un error
      if (ctrl.signal.aborted && ctrl.signal.reason !== "timeout") return;
      const porTiempo = ctrl.signal.reason === "timeout";
      estado.textContent = "";
      mostrarAviso(
        "Se trabó la imprenta",
        porTiempo
          ? "El museo está tardando demasiado en responder. Probá de nuevo en un ratito."
          : "No pude traer las obras. Revisá tu conexión o probá de nuevo.",
        true
      );
      console.warn("[moodboard]", err);
    } finally {
      clearTimeout(temporizador);
    }
  }

  function mostrarResultado(obras: Obra[]) {
    if (obras.length === 0) {
      estado.textContent = "";
      mostrarAviso(
        "Página en blanco",
        `No encontré obras con imagen para “${busquedaActual}”. Probá con otra palabra (en inglés funciona mejor).`,
        false
      );
    } else {
      mostrarObras(obras);
    }
  }

  // ---------- Interacciones ----------
  function elegirChip(chip: HTMLButtonElement | null) {
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      elegirChip(chip);
      cargar(chip.dataset.busqueda!);
    })
  );

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = String(new FormData(form).get("q") ?? "").trim();
    if (!q) return;
    elegirChip(null);
    cargar(q);
  });

  aviso.querySelector("[data-reintentar]")!.addEventListener("click", () => {
    try {
      sessionStorage.removeItem(`mood-vam2:${busquedaActual}`);
    } catch {}
    cargar(busquedaActual);
  });

  // Recién pedimos a la API cuando el moodboard está por aparecer en pantalla
  const alVer = new IntersectionObserver(
    (entradas) => {
      if (entradas.some((e) => e.isIntersecting)) {
        alVer.disconnect();
        cargar(busquedaActual);
      }
    },
    { rootMargin: "400px 0px" }
  );
  alVer.observe(raiz);
</script>
