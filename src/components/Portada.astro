---
// Portada del fanzine. Los recortes entran escalonados (stagger) una sola vez
// al cargar, y después reaccionan suave al mouse (solo en escritorio).

interface Props {
  nombre: string;
  bajada: string;
}

const { nombre, bajada } = Astro.props;
const [primerNombre, ...resto] = nombre.split(" ");
---

<header class="portada" id="hola">
  <div class="portada__texto">
    <p class="portada__edicion">Fanzine N°1 · Portfolio · 2026</p>
    <h1 class="portada__titulo">
      <span class="pieza" style="--i: 0">hola,</span>
      <span class="pieza" style="--i: 1"><em>soy {primerNombre}</em></span>
      <span class="pieza portada__apellido" style="--i: 2">{resto.join(" ")}</span>
    </h1>
    <p class="portada__bajada pieza" style="--i: 3">{bajada}</p>
    <a class="boton boton--lleno pieza" style="--i: 4" href="#trabajos">Abrir el fanzine ↓</a>
  </div>

  <!-- Collage decorativo: dos tintas que se superponen -->
  <div class="portada__collage" aria-hidden="true" data-collage>
    <div class="recorte recorte--azul pieza" style="--i: 2" data-prof="0.6"></div>
    <div class="recorte recorte--rosa pieza" style="--i: 3" data-prof="1"></div>
    <div class="recorte recorte--papel pieza" style="--i: 4" data-prof="0.35">
      <span class="mano">diseño<br />+ código<br />+ imagen</span>
    </div>
    <div class="cinta pieza" style="--i: 5"></div>
    <div class="estrella pieza" style="--i: 6" data-prof="1.4">★</div>
  </div>
</header>

<style>
  .portada {
    min-height: 100svh;
    display: grid;
    align-items: center;
    gap: 40px;
    padding-block: 48px 120px;
  }

  @media (min-width: 860px) {
    .portada {
      grid-template-columns: 1.1fr 1fr;
      padding-block: 64px;
    }
  }

  .portada__edicion {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin: 0 0 20px;
  }

  .portada__titulo {
    font-size: clamp(4rem, 13vw, 8.5rem);
    line-height: 0.9;
    display: flex;
    flex-direction: column;
  }

  .portada__titulo em {
    color: var(--rosa);
  }

  .portada__apellido {
    color: var(--azul);
    /* Leve "corrimiento de registro", como cuando las tintas no calzan perfecto */
    text-shadow: 3px 2px 0 color-mix(in srgb, var(--rosa) 45%, transparent);
  }

  .portada__bajada {
    max-width: 38ch;
    font-size: 1.1875rem;
    color: var(--tinta-suave);
    margin: 28px 0 32px;
  }

  /* ---------- Collage ---------- */
  .portada__collage {
    position: relative;
    aspect-ratio: 1 / 1;
    width: min(100%, 520px);
    justify-self: center;
  }

  .recorte {
    position: absolute;
    border-radius: 2px;
    translate: var(--mx, 0px) var(--my, 0px);
    transition: translate 600ms var(--ease-out);
  }

  .recorte--azul {
    inset: 8% 30% 30% 6%;
    background: var(--azul);
    border-radius: 50%;
    mix-blend-mode: multiply;
    rotate: -4deg;
  }

  .recorte--rosa {
    inset: 28% 6% 8% 32%;
    background: var(--rosa);
    border-radius: 50%;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }

  .recorte--papel {
    left: 4%;
    bottom: 6%;
    width: 38%;
    aspect-ratio: 4 / 5;
    background: var(--papel-2);
    border: 1.5px solid var(--tinta);
    rotate: -7deg;
    display: grid;
    place-items: center;
    text-align: left;
  }

  .recorte--papel .mano {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.05;
    color: var(--tinta);
  }

  .cinta {
    position: absolute;
    left: 14%;
    top: 43%;
    width: 22%;
    height: 7%;
    background: var(--rosa-claro);
    opacity: 0.85;
    rotate: -8deg;
  }

  .estrella {
    position: absolute;
    top: 4%;
    right: 8%;
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--rosa-texto);
    line-height: 1;
    rotate: 12deg;
    translate: var(--mx, 0px) var(--my, 0px);
    transition: translate 600ms var(--ease-out);
  }

  /* ---------- Entrada escalonada ----------
     Cada pieza tiene --i (su orden) y entra 60 ms después de la anterior.
     Solo transform + opacity, para que no trabe. */
  .pieza {
    animation: entrar 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 100ms);
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }
</style>

<script>
  // Parallax suave: cada recorte se mueve un poquito según el mouse,
  // con distinta "profundidad" (data-prof). Solo con mouse y sin movimiento reducido.
  const collage = document.querySelector<HTMLElement>("[data-collage]");
  const conMouse = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (collage && conMouse && !reducido) {
    const piezas = [...collage.querySelectorAll<HTMLElement>("[data-prof]")];
    window.addEventListener(
      "pointermove",
      (e) => {
        const dx = e.clientX / window.innerWidth - 0.5;
        const dy = e.clientY / window.innerHeight - 0.5;
        piezas.forEach((p) => {
          const prof = Number(p.dataset.prof ?? 1);
          p.style.setProperty("--mx", `${(dx * 18 * prof).toFixed(1)}px`);
          p.style.setProperty("--my", `${(dy * 18 * prof).toFixed(1)}px`);
        });
      },
      { passive: true }
    );
  }
</script>
