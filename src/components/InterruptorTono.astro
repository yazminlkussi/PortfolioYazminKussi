---
// Un interruptor tipo iOS que cambia el TONO del texto "sobre mí":
// versión formal (para un CV) o versión risueña (como hablo yo).
// Cambia la lectura del contenido, no solo la decoración.
// Usa un <button role="switch"> para que sea accesible con teclado y lector de pantalla.
---

<div class="tono" data-tono="risuena">
  <div class="tono__control">
    <span class="tono__lado" aria-hidden="true">formal</span>
    <button class="tono__switch" type="button" role="switch" aria-checked="true" aria-label="Modo risueño" data-switch>
      <span class="tono__perilla"></span>
    </button>
    <span class="tono__lado" aria-hidden="true">risueña</span>
  </div>

  <div class="tono__textos" aria-live="polite">
    <div class="tono__texto" data-version="risuena"><slot name="risuena" /></div>
    <div class="tono__texto" data-version="formal" hidden><slot name="formal" /></div>
  </div>
</div>

<style>
  .tono__control {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  .tono__switch {
    position: relative;
    width: 51px;
    height: 31px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #d1d1d6;
    transition: background-color 200ms ease;
  }

  .tono__switch[aria-checked="true"] {
    background: var(--verde);
  }

  .tono__perilla {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.2);
    transition: transform 220ms var(--ease-out);
  }

  .tono__switch[aria-checked="true"] .tono__perilla {
    transform: translateX(20px);
  }

  /* Al presionar, la perilla se estira un poquito (como en iOS) */
  .tono__switch:active .tono__perilla {
    width: 32px;
  }
  .tono__switch[aria-checked="true"]:active .tono__perilla {
    transform: translateX(15px);
  }

  .tono__texto {
    animation: cambiar 260ms var(--ease-out);
  }

  /* El texto nuevo aparece con un leve desenfoque que se aclara */
  @keyframes cambiar {
    from {
      opacity: 0;
      filter: blur(3px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tono]").forEach((raiz) => {
    const sw = raiz.querySelector<HTMLButtonElement>("[data-switch]")!;
    const versiones = raiz.querySelectorAll<HTMLElement>("[data-version]");

    sw.addEventListener("click", () => {
      const risuena = sw.getAttribute("aria-checked") !== "true";
      sw.setAttribute("aria-checked", String(risuena));
      sw.setAttribute("aria-label", risuena ? "Modo risueño" : "Modo formal");
      const elegida = risuena ? "risuena" : "formal";
      raiz.dataset.tono = elegida;
      versiones.forEach((v) => (v.hidden = v.dataset.version !== elegida));
    });
  });
</script>
