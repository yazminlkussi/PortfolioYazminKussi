---
// Nota escrita a mano con una flechita dibujada que apunta a lo que comenta.
// `flecha` indica hacia dónde apunta. La flecha se dibuja una sola vez
// (apuntando a la izquierda) y se gira con CSS según la dirección.

type Direccion =
  | "izquierda"
  | "derecha"
  | "arriba"
  | "abajo"
  | "arriba-izquierda"
  | "arriba-derecha"
  | "abajo-izquierda"
  | "abajo-derecha"
  | "ninguna";

interface Props {
  flecha?: Direccion;
  giro?: number;
  class?: string;
}

const { flecha = "izquierda", giro = -3, class: clase = "" } = Astro.props;
---

<p class:list={["nota mano", `nota--${flecha}`, clase]} style={`--giro: ${giro}deg`}>
  {
    flecha !== "ninguna" && (
      <svg class="nota__flecha" viewBox="0 0 90 40" aria-hidden="true">
        <path
          d="M86 24C72 12 58 8 53 17c-4 8 7 11 9 3 2-8-11-12-25-6-11 5-20 6-30 6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        />
        <path d="M15 12L6 20l10 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  <span><slot /></span>
</p>

<style>
  .nota {
    margin: 0;
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    color: var(--tinta);
    rotate: var(--giro);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 18ch;
  }

  .nota__flecha {
    width: 64px;
    flex: none;
  }

  /* --- Horizontal --- */
  .nota--derecha {
    flex-direction: row-reverse;
  }
  .nota--derecha .nota__flecha {
    transform: scaleX(-1);
  }

  /* --- Vertical: la flecha va arriba o abajo del texto --- */
  .nota--arriba,
  .nota--abajo {
    flex-direction: column;
    gap: 0;
  }
  .nota--abajo {
    flex-direction: column-reverse;
  }
  .nota--arriba .nota__flecha,
  .nota--abajo .nota__flecha {
    width: 56px;
    /* al girarla 90° necesita más alto que el que ocupa acostada */
    margin-block: 14px;
  }
  .nota--arriba .nota__flecha {
    transform: rotate(90deg);
  }
  .nota--abajo .nota__flecha {
    transform: rotate(-90deg);
  }

  /* --- Diagonales --- */
  .nota--arriba-izquierda {
    align-items: flex-start;
  }
  .nota--arriba-izquierda .nota__flecha {
    transform: rotate(40deg);
  }
  .nota--abajo-izquierda {
    align-items: flex-end;
  }
  .nota--abajo-izquierda .nota__flecha {
    transform: rotate(-40deg);
  }
  .nota--arriba-derecha {
    flex-direction: row-reverse;
    align-items: flex-start;
  }
  .nota--arriba-derecha .nota__flecha {
    transform: scaleX(-1) rotate(40deg);
  }
  .nota--abajo-derecha {
    flex-direction: row-reverse;
    align-items: flex-end;
  }
  .nota--abajo-derecha .nota__flecha {
    transform: scaleX(-1) rotate(-40deg);
  }
</style>
