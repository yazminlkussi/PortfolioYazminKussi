---
// Página principal: un cuaderno con una hoja por sección y una por proyecto.
import Base from "../layouts/Base.astro";
import Cuaderno from "../components/Cuaderno.astro";
import HojaProyecto from "../components/HojaProyecto.astro";
import Moodboard from "../components/Moodboard.astro";
import MesaDeCollage from "../components/MesaDeCollage.astro";
import InterruptorTono from "../components/InterruptorTono.astro";
import DialogoContacto from "../components/DialogoContacto.astro";
import VentanaMac from "../components/VentanaMac.astro";
import Seleccion from "../components/Seleccion.astro";
import NotaMano from "../components/NotaMano.astro";
import Carpeta from "../components/Carpeta.astro";
import { proyectos } from "../data/proyectos";

// El índice se arma solo: tapa, sobre mí, un proyecto por hoja, inspo, mesa y contacto
const paginas = [
  { id: "tapa", nombre: "tapa" },
  { id: "yo", nombre: "sobre mí" },
  ...proyectos.map((p) => ({ id: p.slug, nombre: p.slug })),
  { id: "inspo", nombre: "inspo" },
  { id: "mesa", nombre: "mesa" },
  { id: "chau", nombre: "contacto" },
];

const intereses = ["diseño visual", "código", "foto y video", "música", "cine", "arte", "lectura"];

const temasMoodboard = [
  { etiqueta: "collage", busqueda: "collage" },
  { etiqueta: "afiches", busqueda: "poster" },
  { etiqueta: "rosa", busqueda: "pink" },
  { etiqueta: "packaging", busqueda: "packaging" },
  { etiqueta: "fotografía", busqueda: "photograph" },
  { etiqueta: "flores", busqueda: "flowers" },
];

const stickers = [
  { id: "carpeta", texto: "mis cosas", estilo: "carpeta", x: 6, y: 8, giro: -6 },
  { id: "burbuja", texto: "hola! soy yaz", estilo: "burbuja", x: 52, y: 6, giro: 3 },
  { id: "archivo", texto: "idea_final_v3.pdf", estilo: "archivo", x: 74, y: 30, giro: 6 },
  { id: "copiar", texto: "Copiar | Compartir…", estilo: "menu", x: 30, y: 34, giro: -3 },
  { id: "nota", texto: "me río mucho :)", estilo: "mano", x: 8, y: 62, giro: -5 },
  { id: "toggle", texto: "modo creativa", estilo: "toggle", x: 44, y: 70, giro: 4 },
  { id: "cursor", texto: "", estilo: "cursor", x: 82, y: 72, giro: -10 },
  { id: "estrella", texto: "✦", estilo: "estrella", x: 62, y: 46, giro: 12 },
] as const;
---

<Base>
  <main id="contenido">
    <h1 class="sr-only">Yazmin Kussi — portfolio</h1>

    <Cuaderno paginas={paginas}>
      <!-- 01 · Tapa -->
      <section class="hoja tapa" data-hoja="tapa" data-nombre="tapa" aria-labelledby="tapa-titulo">
        <div class="tapa__arriba">
          <p class="etiqueta">portfolio · 2026</p>
          <p class="etiqueta">diseño visual · código · imagen</p>
        </div>

        <div class="tapa__centro">
          <p class="tapa__hola">hola, soy</p>
          <h2 class="tapa__titulo" id="tapa-titulo">
            <Seleccion>Yazmin Kussi</Seleccion>
          </h2>
          <p class="tapa__bajada">
            Estudio multimedia. Diseño, programo y hago imágenes: me gustan las cosas que se sienten hechas a mano,
            aunque sean digitales.
          </p>
        </div>

        <div class="tapa__carpetas">
          {proyectos.map((p) => <Carpeta nombre={p.slug} href={`#${p.slug}`} />)}
          <Carpeta nombre="inspo" href="#inspo" color="azul" />
        </div>

        <p class="tapa__burbuja" aria-hidden="true">agarrá la esquina y pasá la hoja ↘</p>
        <NotaMano class="tapa__nota" flecha="ninguna" giro={-4}>cada hoja, un proyecto</NotaMano>
      </section>

      <!-- 02 · Sobre mí -->
      <section class="hoja" data-hoja="yo" data-nombre="sobre mí" aria-labelledby="yo-titulo">
        <div class="yo">
          <div class="yo__foto">
            <VentanaMac titulo="yo.jpg" giro={-2}>
              <!-- Reemplazar por tu foto: <img src="/yo.jpg" alt="Yazmin sonriendo" /> -->
              <div class="yo__placeholder" aria-hidden="true">
                <span class="mano">yaz ✿</span>
              </div>
            </VentanaMac>
            <NotaMano class="yo__nota" flecha="izquierda" giro={-5}>creativa y curiosa</NotaMano>
          </div>

          <div class="yo__texto">
            <p class="etiqueta">sobre mí</p>
            <h2 class="yo__titulo" id="yo-titulo">un poco de mí</h2>
            <InterruptorTono>
              <Fragment slot="risuena">
                <p>
                  ¡Hola! Soy Yazmín, tengo 23 años y estudio Tecnología Multimedial en la Universidad Maimónides.
                </p>
                <p>
                  Me considero una persona creativa, curiosa e inquieta. Me gusta explorar, experimentar y encontrar
                  nuevas formas de llevar las ideas a la realidad. Disfruto del diseño en sus distintas formas, de
                  combinar disciplinas y de aprender cosas nuevas en cada proyecto.
                </p>
                <p>
                  Siempre estoy buscando inspiración, probando cosas diferentes y descubriendo nuevas maneras de crear.
                </p>
              </Fragment>
              <Fragment slot="formal">
                <p>
                  Yazmín Kussi, 23 años. Estudiante de Tecnología Multimedial en la Universidad Maimónides. Trabajo
                  en la intersección entre diseño visual, desarrollo web e imagen, con foco en experiencias
                  interactivas cuidadas y accesibles.
                </p>
                <p>
                  Mis intereses incluyen la identidad de marca, el diseño de interfaces, la fotografía y el video. Me
                  interesa especialmente el detalle: la tipografía, el movimiento y la respuesta de cada interacción.
                </p>
              </Fragment>
            </InterruptorTono>
            <ul class="pildoras yo__intereses" aria-label="Intereses">
              {intereses.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- Una hoja por proyecto -->
      {proyectos.map((p, i) => <HojaProyecto proyecto={p} numero={i + 1} />)}

      <!-- Inspo -->
      <section class="hoja" data-hoja="inspo" data-nombre="inspo" aria-labelledby="inspo-titulo">
        <p class="etiqueta">inspo</p>
        <h2 class="hoja__titulo" id="inspo-titulo">lo que me <Seleccion cursor={false}>inspira</Seleccion></h2>
        <p class="hoja__bajada">
          Un moodboard vivo con piezas de un museo de verdad. Elegí un tema o buscá algo (en inglés funciona mejor) y
          pegá en la mesa lo que te guste.
        </p>
        <Moodboard temas={temasMoodboard} />
      </section>

      <!-- Mesa -->
      <section class="hoja" data-hoja="mesa" data-nombre="mesa" aria-labelledby="mesa-titulo">
        <p class="etiqueta">mesa de collage</p>
        <h2 class="hoja__titulo" id="mesa-titulo">armá tu <Seleccion cursor={false}>página</Seleccion></h2>
        <p class="hoja__bajada">
          Así trabajo yo: probando, moviendo y volviendo a pegar. Ahora te toca a vos. Tu collage queda guardado en este
          navegador.
        </p>
        <MesaDeCollage stickers={[...stickers]} />
      </section>

      <!-- Contacto -->
      <section class="hoja chau" data-hoja="chau" data-nombre="contacto" aria-labelledby="chau-titulo">
        <div class="chau__grilla">
          <div>
            <p class="etiqueta">contacto</p>
            <h2 class="chau__titulo" id="chau-titulo">¿hacemos algo <Seleccion>juntos?</Seleccion></h2>
            <ul class="chau__links">
              <li><a class="boton" href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram ↗</a></li>
              <li><a class="boton" href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
              <li><a class="boton" href="https://github.com/" target="_blank" rel="noopener">GitHub ↗</a></li>
            </ul>
          </div>
          <div class="chau__dialogo">
            <DialogoContacto email="hola@ejemplo.com" />
            <NotaMano class="chau__nota" flecha="izquierda" giro={-4}>escribime!</NotaMano>
          </div>
        </div>
        <p class="chau__firma">
          <span class="mano">hecho a mano (y con código) por Yazmin Kussi ✿</span>
          <span>Programación Multimedial IV · 2026</span>
        </p>
      </section>
    </Cuaderno>
  </main>
</Base>

<style>
  /* ---------- Títulos comunes de hoja ---------- */
  .hoja__titulo {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    margin: 14px 0 0;
  }

  .hoja__bajada {
    max-width: 56ch;
    color: var(--tinta-suave);
    margin: 18px 0 0;
  }

  /* ---------- Tapa ---------- */
  .tapa {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 32px;
  }

  .tapa__arriba {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tapa__centro {
    align-self: center;
    text-align: center;
    padding-block: 24px;
  }

  .tapa__hola {
    margin: 0 0 6px;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .tapa__titulo {
    font-size: clamp(3.25rem, 12vw, 9rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .tapa__bajada {
    max-width: 44ch;
    margin: 44px auto 0;
    color: var(--tinta-suave);
  }

  .tapa__carpetas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
  }

  .tapa__burbuja {
    justify-self: end;
    margin: 0;
    background: var(--azul);
    color: #fff;
    font-size: 0.9375rem;
    padding: 8px 14px;
    border-radius: 18px 18px 4px 18px;
    box-shadow: var(--sombra-foto);
  }

  :global(.tapa__nota) {
    display: none;
  }

  /* Escritorio: las carpetas y notas se reparten alrededor del título */
  @media (min-width: 900px) {
    .tapa {
      position: relative;
      display: block;
      min-height: min(80svh, 760px);
    }
    .tapa__centro {
      position: absolute;
      inset: 50% 0 auto;
      translate: 0 -50%;
      padding: 0 8%;
    }
    .tapa__carpetas {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .tapa__carpetas :global(.carpeta) {
      position: absolute;
      pointer-events: auto;
    }
    .tapa__carpetas :global(.carpeta:nth-child(1)) { left: 8%; top: 22%; rotate: -5deg; }
    .tapa__carpetas :global(.carpeta:nth-child(2)) { right: 9%; top: 18%; rotate: 4deg; }
    .tapa__carpetas :global(.carpeta:nth-child(3)) { left: 12%; bottom: 10%; rotate: 3deg; }
    .tapa__carpetas :global(.carpeta:nth-child(4)) { right: 14%; bottom: 14%; rotate: -4deg; }
    .tapa__burbuja {
      position: absolute;
      right: 6%;
      bottom: 4%;
    }
    :global(.tapa__nota) {
      display: inline-flex;
      position: absolute;
      left: 30%;
      bottom: 3%;
      max-width: none;
    }
  }

  /* ---------- Sobre mí ---------- */
  .yo {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .yo {
      grid-template-columns: 0.85fr 1fr;
      gap: 64px;
      align-items: center;
    }
  }

  .yo__foto {
    position: relative;
    max-width: 420px;
    padding-bottom: 56px;
  }

  .yo__placeholder {
    aspect-ratio: 4 / 5;
    background: var(--rosa);
    display: grid;
    place-items: center;
  }

  .yo__placeholder .mano {
    font-size: clamp(3rem, 8vw, 4.5rem);
    color: var(--tinta);
  }

  :global(.yo__nota) {
    position: absolute;
    right: -8px;
    bottom: 0;
  }

  .yo__titulo {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 12px 0 24px;
  }

  .yo__texto :global(p:not(.etiqueta)) {
    font-size: 1.125rem;
    margin: 0 0 16px;
  }

  .yo__intereses {
    margin-top: 24px;
  }

  /* ---------- Contacto ---------- */
  .chau {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
  }

  .chau__grilla {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .chau__grilla {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .chau__titulo {
    font-size: clamp(2.75rem, 8vw, 6rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    margin: 14px 0 32px;
  }

  .chau__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chau__dialogo {
    position: relative;
    justify-self: center;
    padding-bottom: 60px;
  }

  :global(.chau__nota) {
    position: absolute;
    right: -20px;
    bottom: 0;
  }

  .chau__firma {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  .chau__firma .mano {
    font-size: 1.5rem;
    color: var(--rosa-texto);
  }
</style>
